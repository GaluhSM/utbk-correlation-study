linters: linters_with_defaults(
    line_length_linter(80L),
    object_name_linter(styles = c("snake_case", "SNAKE_CASE")),
    trailing_whitespace_linter(),
    trailing_blank_lines_linter(),
    object_usage_linter(),
    commented_code_linter()
  )
exclusions: list(
    "renv",
    "output"
  )
